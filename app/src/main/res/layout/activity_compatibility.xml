<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/compatRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground" android:clipChildren="false">
