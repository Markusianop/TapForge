<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/batchRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground" android:clipChildren="false" android:clipToPadding="false">
    <LinearLayout android:id="@+id/batchContent" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingBottom="28dp">
        <LinearLayout android:id="@+id/batchHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/batchBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back" android:padding="12dp" android:src="@drawable/ic_back" />
            <TextView android:id="@+id/batchHeaderTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:layout_weight="1" android:text="@string/batch_write" android:textColor="?android:attr/textColorPrimary" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout android:id="@+id/batchStage" android:layout_width="300dp" android:layout_height="300dp" android:layout_gravity="center_horizontal" android:layout_marginTop="28dp" android:clipChildren="false" android:clipToPadding="false">
            <View android:id="@+id/batchHaloOuter" android:layout_width="220dp" android:layout_height="220dp" android:layout_gravity="center" android:background="@drawable/bg_scan_halo" />
            <View android:id="@+id/batchHalo" android:layout_width="178dp" android:layout_height="178dp" android:layout_gravity="center" android:background="@drawable/bg_scan_halo" />
            <ImageView android:id="@+id/batchGlyph" android:layout_width="116dp" android:layout_height="116dp" android:layout_gravity="center" android:src="@drawable/ic_tf_brandmark" />
        </FrameLayout>
        <TextView android:id="@+id/batchTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/ready_for_tags" android:textColor="?android:attr/textColorPrimary" android:textSize="23sp" android:textStyle="bold" />
        <TextView android:id="@+id/batchSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="@string/ready_for_tags_subtitle" android:textColor="?android:attr/textColorSecondary" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/batchCounter" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?android:attr/textColorPrimary" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/batchMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
            <CheckBox android:id="@+id/batchVerify" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:buttonTint="?android:attr/colorAccent" android:checked="true" android:text="@string/verify_after_write" android:textColor="?android:attr/textColorPrimary" />
            <CheckBox android:id="@+id/batchDuplicateGuard" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="?android:attr/colorAccent" android:checked="true" android:text="@string/skip_duplicates" android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>
        <Button android:id="@+id/batchToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_primary_button" android:minHeight="54dp" android:text="@string/start_batch" android:textAllCaps="false" android:textColor="@android:color/white" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
