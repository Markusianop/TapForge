<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/compareRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground" android:clipChildren="false">
    <LinearLayout android:id="@+id/compareContent" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingBottom="28dp">
        <LinearLayout android:id="@+id/compareHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/compareBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back" android:padding="12dp" android:src="@drawable/ic_back" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:layout_weight="1" android:text="@string/compare_tags" android:textColor="?android:attr/textColorPrimary" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout android:id="@+id/compareStage" android:layout_width="280dp" android:layout_height="280dp" android:layout_gravity="center_horizontal" android:layout_marginTop="28dp" android:clipChildren="false" android:clipToPadding="false">
            <View android:id="@+id/compareHaloOuter" android:layout_width="210dp" android:layout_height="210dp" android:layout_gravity="center" android:background="@drawable/bg_scan_halo" />
            <View android:id="@+id/compareHalo" android:layout_width="170dp" android:layout_height="170dp" android:layout_gravity="center" android:background="@drawable/bg_scan_halo" />
            <ImageView android:id="@+id/compareGlyph" android:layout_width="112dp" android:layout_height="112dp" android:layout_gravity="center" android:src="@drawable/ic_tf_brandmark" />
        </FrameLayout>
        <TextView android:id="@+id/compareTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/scan_first_tag" android:textColor="?android:attr/textColorPrimary" android:textSize="23sp" android:textStyle="bold" />
        <TextView android:id="@+id/compareSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="@string/scan_first_tag_subtitle" android:textColor="?android:attr/textColorSecondary" android:textSize="14sp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="18dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:id="@+id/compareResultCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
                <TextView android:id="@+id/compareResultTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?android:attr/textColorPrimary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/compareResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="?android:attr/textColorSecondary" android:textIsSelectable="true" android:textSize="13sp" />
                <Button android:id="@+id/compareAgain" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_secondary_button" android:minHeight="50dp" android:text="@string/compare_another" android:textAllCaps="false" android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
