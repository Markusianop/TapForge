<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tagScanRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/tagScanHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="20dp">
        <ImageButton
            android:id="@+id/tagScanBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />
        <TextView
            android:id="@+id/tagScanHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/tagScanCenter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">
        <FrameLayout
            android:id="@+id/tagScanStage"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_centerInParent="true"
            android:clipChildren="false"
            android:clipToPadding="false">
            <View
                android:id="@+id/tagHaloOuter"
                android:layout_width="206dp"
                android:layout_height="206dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_scan_halo" />
            <View
                android:id="@+id/tagHalo"
                android:layout_width="166dp"
                android:layout_height="166dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_scan_halo" />
            <ImageView
                android:id="@+id/tagGlyph"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_tf_brandmark" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/tagScanCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tagScanStage"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">
            <TextView
                android:id="@+id/tagScanTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tagScanSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="390dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="15sp" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:id="@+id/tagResultScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:fillViewport="false"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/tagResultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:id="@+id/tagResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tagResultMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textIsSelectable="true"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tagResultContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textIsSelectable="true"
                android:textSize="15sp" />
            <Button
                android:id="@+id/tagPrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_primary_button"
                android:minHeight="50dp"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            <Button
                android:id="@+id/tagSecondaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_secondary_button"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold"
                android:visibility="gone" />
            <Button
                android:id="@+id/tagTertiaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_secondary_button"
                android:minHeight="48dp"
                android:text="@string/save_to_library"
                android:textAllCaps="false"
                android:textColor="?android:attr/textColorPrimary"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
