                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/tools_everything_nfc_subtitle" android:textColor="?android:attr/textColorSecondary" android:textSize="14sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/tools_essentials" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" android:textStyle="bold" />
